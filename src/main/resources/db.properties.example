# Copy this file to db.properties (same folder) and fill in your local
# MySQL credentials. db.properties itself is gitignored and never committed;
# in production, set DB_URL / DB_USERNAME / DB_PASSWORD env vars instead,
# which override anything in this file (see com.db.DBConnect).
db.url=jdbc:mysql://localhost:3306/vehicle_rental?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
db.username=root
db.password=changeme
